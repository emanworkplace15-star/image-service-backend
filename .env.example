# --- Database (required) ---
# Local dev: postgres from docker-compose in this repo
# AWS: RDS Postgres endpoint (from Secrets Manager / SSM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imagedb

# --- AWS (required) ---
# Region of the S3 bucket / RDS instance
AWS_REGION=eu-west-1
S3_BUCKET=my-image-bucket

# Local dev only — export static keys. On AWS (EKS/ECS/EC2) leave these unset
# and let the instance/task/pod role resolve via the default credential chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Auth (required) ---
# JWT signing secret for admin login (generate: openssl rand -hex 32)
JWT_SECRET=change-me
# Shared secret that must match the Lambda's LAMBDA_API_KEY
LAMBDA_API_KEY=change-me-too

# --- Optional ---
# Presigned GET URL lifetime in seconds (default 3600)
PRESIGN_EXPIRES=3600
# Allowed CORS origins, comma-separated, or * for any (default *)
CORS_ORIGIN=http://localhost:3000
PORT=3001

# --- Realtime notifications (optional) ---
# How the Lambda's result reaches this backend: 'api' (direct HTTP, default)
# or 'sqs' (backend consumes events from an SQS queue)
NOTIFY_MODE=api
# SQS queue URL — required only when NOTIFY_MODE=sqs
# SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/image-service-events
