{
  "name": "image-service-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS backend: presigned S3 uploads, image metadata in Postgres (Prisma), admin JWT auth",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "tsc -w & node --watch dist/main.js",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.741.0",
    "@aws-sdk/client-sqs": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.741.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/websockets": "^11.2.3",
    "@prisma/client": "^6.4.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "install": "^0.13.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.1",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
